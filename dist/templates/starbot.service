# NovaBot systemd 单元文件
#
# 安装：
#   sudo useradd --system --home-dir /opt/starbot --shell /usr/sbin/nologin starbot
#   sudo cp -r dist/build /opt/starbot && sudo chown -R starbot:starbot /opt/starbot
#   sudo cp dist/templates/starbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now starbot
#
# 首次启动需要扫码登录，先用 journalctl -u starbot -f 查看二维码。

[Unit]
Description=NovaBot - 哔哩哔哩直播与动态推送机器人
Documentation=https://github.com/rossinova/NovaBot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starbot
Group=starbot
WorkingDirectory=/opt/starbot
ExecStart=/opt/starbot/start.sh
Restart=on-failure
RestartSec=10s

# 143 = 128 + SIGTERM(15)，也就是 `systemctl stop` 之后 JVM 正常退出的码。
# 不声明它的话每次正常停机都会在 journal 里留一行
# 「starbot.service: Failed with result 'exit-code'」——关停其实是干净的
# （data.json 已保存、tomcat graceful shutdown complete）。
# 那行纯噪声，但它训练人忽略 `Failed` 字样，而下一次真的失败长得一模一样。
SuccessExitStatus=143

# 凭据文件需保持仅属主可读写
UMask=0077

# 安全加固：限制服务对系统其余部分的访问
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/opt/starbot

# 内存上限必须高于 JVM 自己的上限之和，否则堆真涨到 -Xmx 时会先被 cgroup 杀掉：
# SIGKILL 不给优雅停机的机会（可能停在写 cookies.json 的中途），
# 再配合上面的 Restart=on-failure 就成了崩溃循环。
# start.sh 的设置是 -Xmx512m + MaxMetaspaceSize=192m，加上线程栈、代码缓存与
# 直接内存约 150M，合计约 854M——这是**装得下的下限，不是该配的值**。
# 想要更低的硬上限，应当同步调低 start.sh 里的 -Xmx，而不是只压这里。
#
# ⚠️ MemoryHigh 是节流，不是警戒线，必须设在「稳态峰值之上」。
# 超过它之后内核不杀进程，而是对**每一次内存分配**施加睡眠惩罚并强制同步回收，
# 机器没有 swap 时更慢。表现为整个进程被均匀拖慢数秒：本机回环调用比走公网还慢，
# 而 CPU 几乎不动、堆完全健康，极难往内存上想。
#
# 这里原本是 768M，低于实测稳态峰值 896M，于是服务热起来之后余生都在被节流。
# 2026-08-10 实测：memory.events 的 high 计数以约 44 次/秒持续增长，
# 一个本机回环的 HTTP 调用要 2~11 秒，而 curl 打同一地址只要 1.3 毫秒；
# 抬限之后同一个调用当场回到 3 毫秒。
# 抬限不增加任何内存需求——那些内存本来就在被占用，抬限只是停止在预算内自我惩罚。
#
# 现在这一组是**跑出来的，不是算出来的**：2026-08-10 起就按这两个值在线上连续运行，
# memory.events 的 high / max / oom 三个计数一直是 0。
# ⚠️ 峰值的口径要看清：896M 是「2 位主播、功能全开、连续 63 小时」下的**稳态峰值，
# 不是上界**——主播更多或瞬时高峰更猛时还会往上走，那种场景没有测过。
# 所以这组值是「实测峰值 + 说得出理由的余量」，不是一个算尽的容量：
# 主播数明显更多时自己往上调，别把它当成官方给的天花板。
#
# 🔴 1 GB 的机器装不下这一组，要连同 start.sh 的 -Xmx 一起往下调，
# 手册 docs/performance.md 里给了一组按公式算的值。只压这里会换来上面那种静默变慢。
#
# 启动时程序会自己读这两个值与 JVM 上限比对，装不下会在日志里明说。
MemoryHigh=1.2G
MemoryMax=1.5G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=starbot

[Install]
WantedBy=multi-user.target
