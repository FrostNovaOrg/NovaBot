<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
        🔴 defaultValue 不是可选的。配置项 novabot.core.log.console / .file 的模板默认是**留空**，
        留空时这两个变量根本没有定义，${fileLogLevel} 会被替换成字面量
        「fileLogLevel_IS_UNDEFINED」，而 ThresholdFilter 解析不了它时会退回 DEBUG。
        结果是**开箱即用的部署把 DEBUG 全写进日志文件**——实测模板默认跑 25 秒，
        文件里 140 行 DEBUG 对 87 行 INFO。这个失效不报错、不告警，只是安静地多写。

        下面这个 logger 的 DEBUG 是**故意写死的**，不要改成跟随变量：
        它让 DEBUG 事件到得了各个 appender，由每个 appender 的 ThresholdFilter 各自决定收不收。
        改成跟随 fileLogLevel 之后，「控制台开 DEBUG 排障、文件仍留 INFO」这件事就做不到了，
        而那正是配置注释里让人去做的事。
    -->
    <springProperty name="consoleLogLevel" source="novabot.core.log.console" defaultValue="INFO"/>
    <springProperty name="fileLogLevel" source="novabot.core.log.file" defaultValue="INFO"/>

    <!--
        🔴 LOG_HOME 不是「让人换目录」的便利项，是一道守卫。
        下面三棵日志树原本写的是相对路径，于是从**仓库工作树**里跑起来时，
        日志就落进仓库目录树——而日志里有观众 uid、昵称与房间号。
        它比运行时数据更容易触发：跑一次 `mvn test` 就有，不用启动程序
        （实测三个模块下各写一份，共 46 个文件）。

        故用 logback 自己的 PropertyDefiner 求这个值，**不挂在 Spring 上**：
        mvn test 跑单元测试时 Spring 可能根本没起来，logback 却已经在写盘了。
        挂在 Spring 上的守卫盖不住那条路。

        生产形状（目录上溯不到 .git）它返回 "."，落点与本改动之前**逐字节相同**。
    -->
    <define name="LOG_HOME" class="org.frostnova.nova.core.config.LogHomeDefiner"/>

    <logger name="org.reflections.Reflections" level="OFF"/>
    <logger name="org.apache.catalina.loader.WebappLoader" level="OFF"/>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${consoleLogLevel}</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} --- [%clr(%20.20t)] %clr(%-40.40logger{39}){cyan} : %msg%n%ex
            </pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="ConsoleQrCode" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${consoleLogLevel}</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %msg%n
            </pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <!--
        日志保留：两档制，30 天与 7 天。
        排障资产（logs 与 NetworkDebug）留 30 天，事件调试日志（EventDebug）留 7 天。
        🔴 分档的依据是**内容性质，不是体积**：EventDebug 里逐条堆着观众昵称与 uid，
        留得越久，一台机器上攒下的旁人身份数据越多；而排障日志要的恰恰是「往回看得多远」。

        30 天是**声明出来的默认值，不是量出来的结论**——与下播记录的保留期
        （DefaultLiveDataService.DOWNTIME_RETENTION_MILLIS）取同一个数，
        好让「这台机器上的东西留多久」只有一个答案。手上只有两次「回头翻日志」的实际样本，
        都落在一周之内，不足以定分布，所以不假装它有测量支撑：改它是改一个约定，不是推翻一个结论。

        totalSizeCap 是**兜底，不是配额**：防的是某天量突然翻十倍时把盘写满，平时碰不到。
        取法是「当前日量 × 保留天数 × 10」，逐档的输入与结果（日量均为实测）：

          logs          2.0 MiB/日（2026-08-31、09-01） × 30 × 10 = 600 MiB → 1GB
          NetworkDebug  2.6 MiB/日（2026-08-11 ~ 08-29）× 30 × 10 = 786 MiB → 1GB
          EventDebug    1.3 MiB/日（2026-08-31）        ×  7 × 10 =  92 MiB → 128MB

        余量另按「同一套开关下量到的最大单日」核对过：logs 7.4 MiB/日 × 30 天 = 220 MiB、
        NetworkDebug 10.8 MiB/日 × 30 天 = 325 MiB、EventDebug 最大的那一天 20.8 MiB
        加另外 6 个常规日约 29 MiB——三档都在上限之内，各留着数倍余地。

        ⚠️ 日量随主播数、开播时长与调试开关变化，**开关一改就要重算**。量过的一例：
        bilibili.debug.live-room-raw-message-log 开着时 logs 是 50–75 MiB/日，
        比上表高一个量级，30 天要 2 GiB 以上——要长期开着它，这里得一起抬。

        🔴 totalSizeCap 必须与 maxHistory 同时写才生效。只给上限时 logback 不抛异常、不影响启动，
        只在配置期的状态流里留一行
        「'maxHistory' is not set, ignoring 'totalSizeCap' option」——
        一行淹在启动噪声里的 WARN 挡不住这种漏配，所以另有一条构建期检查钉着它。
    -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${fileLogLevel}</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/logs/%d{yyyy-MM,aux}/novabot-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID:- } --- [%20.20t] %-40.40logger{39} : %msg%n</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="AsyncRollingFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="RollingFile"/>
        <includeCallerData>true</includeCallerData>
    </appender>

    <appender name="EventRollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/EventDebug/%d{yyyy-MM,aux}/novabot-event-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>128MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} : %msg%n</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="EventAsyncRollingFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="EventRollingFile"/>
        <includeCallerData>true</includeCallerData>
    </appender>

    <appender name="NetworkRollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/NetworkDebug/%d{yyyy-MM,aux}/novabot-network-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p --- [%20.20t] : %msg%n</pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="NetworkAsyncRollingFile" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="NetworkRollingFile"/>
        <includeCallerData>true</includeCallerData>
    </appender>

    <logger name="org.frostnova.nova.core.util.QrCodeUtil" level="INFO" additivity="false">
        <appender-ref ref="ConsoleQrCode"/>
        <appender-ref ref="AsyncRollingFile"/>
    </logger>

    <logger name="EventLogger" level="DEBUG" additivity="false">
        <appender-ref ref="EventAsyncRollingFile"/>
    </logger>

    <logger name="NetworkLogger" level="DEBUG" additivity="false">
        <appender-ref ref="NetworkAsyncRollingFile"/>
    </logger>

    <logger name="org.frostnova.nova" level="DEBUG" additivity="false">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncRollingFile"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="Console"/>
        <appender-ref ref="AsyncRollingFile"/>
    </root>
</configuration>