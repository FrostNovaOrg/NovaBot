<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.frostnova.nova</groupId>
        <artifactId>nova-parent</artifactId>
        <version>5.7.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>nova-console</artifactId>
    <version>1.0.0</version>
    <name>NovaBotConsole</name>
    <description>NovaBot console product pages</description>

    <dependencies>
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>novacore</artifactId>
        </dependency>

        <!--
            只在测试里用：要量的是「控制台把开关关掉之后，群里那几条命令还应不应答」，
            得把真命令摆在真分发器前面跑一遍，替身答不了这一问。
            只作测试依赖，不进插件产物（依赖描述只收 compile / runtime 两档）
        -->
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-report</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            只在测试里用：设置项说明要读这些模块编译出来的说明。
            不声明的话，单独构建本模块时那些说明还没生成。
            只作测试依赖，不进插件产物。
        -->
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-bilibili</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-onebot-adapter</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-onebot-adapter-napcat-extension</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.frostnova.nova</groupId>
                <artifactId>nova-plugin-processor</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>plugin-info-process</goal>
                            <goal>dependency-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <!--
                                    只取 nova-plugin-processor 生成的两个描述文件。
                                    若照搬整个 target 目录，test-classes 也会被打进插件 jar，
                                    而 jar 里的测试类落在本模块自报类的组件扫描范围内，
                                    启动时被一并扫进容器，测试期依赖又不在运行期产物里，
                                    结果是 NoClassDefFoundError，整个应用起不来。
                                -->
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>plugin.json</include>
                                        <include>dependency.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <resources>
                        <resource>
                            <directory>src/main/resources</directory>
                            <excludes>
                                <exclude>application.yml</exclude>
                                <exclude>application.properties</exclude>
                                <exclude>application-dev.yml</exclude>
                                <exclude>application-dev.properties</exclude>
                            </excludes>
                        </resource>
                    </resources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
