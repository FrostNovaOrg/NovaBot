<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.frostnova.nova</groupId>
        <artifactId>nova-parent</artifactId>
        <version>5.4.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>nova-bilibili</artifactId>
    <version>1.0.0</version>
    <name>NovaBilibili</name>
    <description>NovaBot For Bilibili</description>

    <!--
        本模块为依据哔哩哔哩公开接口独立编写的实现，不含任何来自上游二进制的反编译代码。
        对外暴露的事件类型与配置项命名与上游保持兼容，既有 datasource.json 与
        application.yml 可直接沿用。
    -->
    <dependencies>
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>nova-core</artifactId>
        </dependency>

        <!--
            事件输出协议的校验器（NovaProtocolSchema）随协议真源待在 novacore 的测试域里，
            本模块的映射器判据按它校验产出的信封。依赖管理里那条 test-jar 单列一项：
            那张表按 groupId:artifactId:type 匹配，test-jar 与普通 jar 不是同一个键
        -->
        <dependency>
            <groupId>org.frostnova.nova</groupId>
            <artifactId>novacore</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- 直播间弹幕流的数据包可能使用 brotli 压缩 -->
        <dependency>
            <groupId>org.brotli</groupId>
            <artifactId>dec</artifactId>
        </dependency>

        <!-- 主播信息、礼物配置等的本地缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 弹幕词云的分词；排版与绘制见 painter/WordCloudLayout -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.frostnova.nova</groupId>
                <artifactId>nova-plugin-processor</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>plugin-info-process</goal>
                            <goal>dependency-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <!--
                                    只取 nova-plugin-processor 生成的两个描述文件。
                                    若照搬整个 target 目录，test-classes 也会被打进插件 jar，
                                    而 jar 里的测试类落在本模块自报类的组件扫描范围内，
                                    启动时被一并扫进容器，测试期依赖又不在运行期产物里，
                                    结果是 NoClassDefFoundError，整个应用起不来。
                                -->
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>plugin.json</include>
                                        <include>dependency.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <resources>
                        <resource>
                            <directory>src/main/resources</directory>
                            <excludes>
                                <exclude>application.yml</exclude>
                                <exclude>application.properties</exclude>
                                <exclude>application-dev.yml</exclude>
                                <exclude>application-dev.properties</exclude>
                            </excludes>
                        </resource>
                    </resources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
