<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.starlwr</groupId>
    <artifactId>starbot-parent</artifactId>
    <version>5.0.1</version>
    <packaging>pom</packaging>

    <name>NovaBot</name>
    <description>NovaBot 聚合构建 — 哔哩哔哩直播与动态推送机器人</description>
    <url>https://github.com/FrostNovaOrg/NovaBot</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>LWR</id>
            <name>LWR</name>
            <email>lwr1104@qq.com</email>
            <roles>
                <role>StarBot 原作者</role>
            </roles>
        </developer>
    </developers>

    <!--
        build-tools/starbot-plugin-processor 是本工程各插件模块在 build 阶段调用的 Maven 插件。
        Maven 无法在同一 reactor 内构建并使用同一个插件，因此它不在此处的模块列表中，
        需先单独安装（执行 ./build.sh 会自动完成）。
        templates/starbot-example-plugin 是提供给第三方插件开发者的模板，同样不参与本工程构建。
    -->
    <modules>
        <!-- novacore 排在最前：starbot-core 编译期依赖它，reactor 按声明顺序解析 -->
        <module>novacore</module>
        <module>starbot-core</module>
        <module>starbot-onebot-adapter</module>
        <module>starbot-onebot-adapter-napcat-extension</module>
        <module>starbot-bilibili</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- StarBot 自身构件版本 -->
        <novacore.version>5.0.1</novacore.version>
        <starbot-core.version>5.0.1</starbot-core.version>
        <starbot-plugin-processor.version>1.0.0</starbot-plugin-processor.version>

        <!-- 构建期判据用的插件，版本钉死：判据本身跟着上游漂就不成其为判据 -->
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>

        <!-- 第三方依赖版本，集中在此管理，模块内不再各写各的 -->
        <fastjson2.version>2.0.56</fastjson2.version>
        <reflections.version>0.10.2</reflections.version>
        <imageio-webp.version>3.12.0</imageio-webp.version>
        <zxing.version>3.5.3</zxing.version>
        <spring-retry.version>2.0.12</spring-retry.version>
        <!-- org.brotli:dec 在 Maven Central 上仅发布过 0.1.2 这一个版本 -->
        <brotli.version>0.1.2</brotli.version>
        <caffeine.version>3.2.0</caffeine.version>
        <!-- 弹幕词云：jieba 的 Java 移植负责分词，kumo 负责词云渲染 -->
        <jieba-analysis.version>1.0.2</jieba-analysis.version>
        <kumo.version>1.28</kumo.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                版本走属性而不是 ${project.version}：各插件模块自己的 version 是 1.0.0，
                依赖管理是继承下去的，${project.version} 在那几个模块里解出来的是 1.0.0，
                于是 novacore 作为传递依赖被解析成一个根本不存在的坐标——
                报错发生在插件模块，指着的却是这一行。属性由下面的 enforcer 判据守着别漏改。
            -->
            <dependency>
                <groupId>com.starlwr</groupId>
                <artifactId>novacore</artifactId>
                <version>${novacore.version}</version>
            </dependency>
            <dependency>
                <groupId>com.starlwr</groupId>
                <artifactId>novacore</artifactId>
                <version>${novacore.version}</version>
                <type>test-jar</type>
            </dependency>

            <dependency>
                <groupId>com.starlwr</groupId>
                <artifactId>starbot-core</artifactId>
                <version>${starbot-core.version}</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twelvemonkeys.imageio</groupId>
                <artifactId>imageio-webp</artifactId>
                <version>${imageio-webp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.retry</groupId>
                <artifactId>spring-retry</artifactId>
                <version>${spring-retry.version}</version>
            </dependency>
            <dependency>
                <groupId>org.brotli</groupId>
                <artifactId>dec</artifactId>
                <version>${brotli.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huaban</groupId>
                <artifactId>jieba-analysis</artifactId>
                <version>${jieba-analysis.version}</version>
            </dependency>
            <dependency>
                <groupId>com.kennycason</groupId>
                <artifactId>kumo-core</artifactId>
                <version>${kumo.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 全模块统一引入：Lombok（编译期）与测试栈 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.starlwr</groupId>
                    <artifactId>starbot-plugin-processor</artifactId>
                    <version>${starbot-plugin-processor.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
                发版要改的字面版本号有两处：本工程的 version，以及上面那个 starbot-core.version。
                后者是各插件模块编译期依赖的 core 版本，改漏了构建照常绿——插件模块会去本机仓库里
                翻出上一版的 core 来编译，产物看不出异样，问题要到运行期才炸——上一版就是这么漏的。
                这条判据把「漏改」从一件靠人记的事变成一件构建当场拒绝的事。

                inherited=false：这一条问的是本工程的两个版本号对不对得上，是聚合工程自己的事，
                各模块跟着跑一遍只是把同一句话重复四次。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>check-starbot-core-version</id>
                        <!-- 绑在 validate：编译一个字节之前就该拦下，而不是等构建跑完再说 -->
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!--
                                    novacore 与工程同进同出，版本永远一致；写成属性只是因为
                                    ${project.version} 在插件模块里会解成插件自己的版本。
                                    既然是个能漏改的字面量，就照 starbot-core 那条一样守住。
                                -->
                                <requireProperty>
                                    <property>novacore.version</property>
                                    <regex>\Q${project.version}\E</regex>
                                    <message>novacore.version 须与工程版本一致：请把它改成 ${project.version}</message>
                                    <regexMessage>novacore.version 与工程版本 ${project.version} 对不上：改漏了这一处，各模块会去仓库里翻上一版的 novacore，翻不到就报「找不到构件」，而报错指向的是插件模块</regexMessage>
                                </requireProperty>
                                <requireProperty>
                                    <property>starbot-core.version</property>
                                    <!-- \Q..\E 把工程版本整段当字面量比，版本号里的点不会被当成通配 -->
                                    <regex>\Q${project.version}\E</regex>
                                    <message>插件模块编译依赖的 core 版本须与工程版本一致：请把 starbot-core.version 改成 ${project.version}</message>
                                    <regexMessage>插件模块编译依赖的 core 版本须与工程版本一致：starbot-core.version 与工程版本 ${project.version} 对不上，改漏了这一处，插件模块会拿本机仓库里的旧 core 编译</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
