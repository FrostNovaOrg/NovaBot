<?xml version="1.0" encoding="UTF-8"?>
<!--
    测试专用日志配置：logger 与级别照正式的那份 logback.xml，只是不写文件，全打控制台。

    🔴 测试不能吃正式配置：从工作树里跑时 LogHomeDefiner 把日志根改写到 ~/.novabot/，
    测试造出来的告警、报错就混进使用者本机那份日志，排障时读到的是假告警。
    logback 与 Spring Boot 都先找 logback-test.xml，找到就不再读 logback.xml。

    本件由根 pom 的 surefire 配置挂到每个模块的测试类路径上，只此一份，不进任何产物。
    改正式配置里的 logger 或级别时，这里跟着改。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 不经 Spring 起的测试里 springProperty 不生效，故级别处另写 :-INFO 兜底，与正式配置的默认值相同 -->
    <springProperty name="consoleLogLevel" source="novabot.core.log.console" defaultValue="INFO"/>

    <logger name="org.reflections.Reflections" level="OFF"/>
    <logger name="org.apache.catalina.loader.WebappLoader" level="OFF"/>

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${consoleLogLevel:-INFO}</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} --- [%clr(%20.20t)] %clr(%-40.40logger{39}){cyan} : %msg%n%ex
            </pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="ConsoleQrCode" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${consoleLogLevel:-INFO}</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %msg%n
            </pattern>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <logger name="org.frostnova.nova.core.util.QrCodeUtil" level="INFO" additivity="false">
        <appender-ref ref="ConsoleQrCode"/>
    </logger>

    <logger name="EventLogger" level="DEBUG" additivity="false">
        <appender-ref ref="Console"/>
    </logger>

    <logger name="NetworkLogger" level="DEBUG" additivity="false">
        <appender-ref ref="Console"/>
    </logger>

    <logger name="org.frostnova.nova" level="DEBUG" additivity="false">
        <appender-ref ref="Console"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="Console"/>
    </root>
</configuration>
