# ---- 构建产物 ----
target/
dist/build/
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- 运行期数据（含凭据，务必不要提交）----
cookies.json
cookies.enc
# 加密密钥。它与 cookies.json 合起来等同于账号密码，同样不能进仓库
cookies.key
# 明文凭据迁移为加密存储时留下的备份
cookies.json.plain.bak
datasource.json
application-local.yml
application-dev.yml
logs/
*.log

# ---- 本机工作备忘（含本机路径，不对外）----
docs/WORK-STATE.md

# 本地脚本跑过之后留下的 Python 字节码
__pycache__/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ---- 系统 ----
.DS_Store
Thumbs.db

# 本机运维备忘，含服务器与账号信息，不进仓库
docs/OPS-NOTES.md

# 本地开发用的启动配置，含本机路径
.claude/

# 产品需求文档，暂不公开
docs/PRD-5.0.md
dist/*.tar.gz
docs/PRD-6.0-运营分析.md

# 冻结待办（含本机路径与未公开需求）
docs/BACKLOG-冻结.md

# 敏感串扫描清单：真值只存本机一份，正本在仓库外
# （~/.claude/projects/<项目>/novabot-scan-patterns.txt）。
# 这几条是防御性的——万一哪天有人把副本放进仓库，别让它跟着推出去。
*scan-pattern*
*sensitive-patterns*
*.bundle

# 运行时数据文件。程序在安装目录生成，但从仓库根跑起来时会落在这里。
# 内容都含他人个人信息或本机身份：
#   state.json      推送目标的群号／QQ 号
#   data.json       本场计分表，含观众 uid 与昵称
#   sessions.jsonl  场次归档（F5 落地后含观众 uid 名单）
#   snapshots.jsonl 主播基础数据快照
# 2026-08-12 核过：四者从未被提交过，这里补的是守卫不是补救。
state.json
data.json
sessions.jsonl
snapshots.jsonl
EventDebug/
NetworkDebug/
